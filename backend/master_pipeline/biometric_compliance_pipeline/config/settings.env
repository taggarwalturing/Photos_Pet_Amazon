# Biometric Compliance Pipeline - High Accuracy Configuration
# ==============================================================
# Version 2.0 - Enhanced with multi-stage validation and EgoBlur

# Directory Configuration
INPUT_DIR=data/input  # Change this to your custom input folder
OUTPUT_DIR=data/obfuscated
QA_DIR=data/qa_review
CLEAN_DIR=data/clean  # Images with no faces (ready to use)

# API Keys
TURING_API_KEY=turing_b79ab4224aeb8c206bf981128c1703f140ab5c2d516b9eb94531d8b2e0fb2a7d

# Detection Thresholds
STANDARD_CONFIDENCE=0.6
ENHANCED_CONFIDENCE=0.4

# Person Validation (YOLO-based, reduces false positives)
REQUIRE_PERSON_VALIDATION=true
PERSON_DETECTION_CONFIDENCE=0.3

# Quality Filtering (filters silhouettes and low-quality detections)
MIN_FACE_BRIGHTNESS=40  # 0-255, filters silhouettes
MIN_FACE_CONTRAST=30    # std dev, filters featureless faces

# Animal Face Filtering (prevents obfuscating cat/dog faces)
FILTER_ANIMAL_FACES=True  # Set to False to disable animal filtering
ANIMAL_IOU_THRESHOLD=0.3  # Min overlap with animal to skip face (0.0-1.0)

# Enhanced Privacy Jurisdictions (comma-separated)
ENHANCED_JURISDICTIONS=IL,CO,TX,WA,NY,MD,JP,CA,EU

# Anonymization Method
# Options: egoblur (recommended), gaussian (compliance), pixelate, solid
ANONYMIZATION_METHOD=egoblur

# EgoBlur Parameters (context-preserving anonymization)
EGOBLUR_INTENSITY=1.0  # 1.0 = default, 1.5 = stronger blur

# Gaussian Blur Parameters (compliance-focused, strong obfuscation)
BLUR_KERNEL_SIZE=99
BLUR_SIGMA=30

# Pixelate Parameters
PIXELATE_SIZE=12  # Pixel size for mosaic effect

# Face Region Parameters
FACE_PADDING_RATIO=0.3  # Extra padding around face

# Re-verification Threshold (after obfuscation)
VERIFICATION_THRESHOLD=0.3  # Max confidence for passing verification

# QA Sampling Rates
STANDARD_SAMPLING_RATE=0.10
ENHANCED_SAMPLING_RATE=1.0

# Model Configuration
FACE_DETECTOR_MODEL=buffalo_sc  # InsightFace model (buffalo_sc = fast, buffalo_l = accurate)
DETECTION_SIZE=640

# Pipeline Version
PIPELINE_VERSION=2.1
