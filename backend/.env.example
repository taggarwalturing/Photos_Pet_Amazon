# ============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=Amazon Delivery Dashboard API
APP_VERSION=1.0.0
DEBUG=True
HOST=0.0.0.0
PORT=5001

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=AmazonPhotoPet
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/AmazonPhotoPet

# ============================================================================
# API SETTINGS
# ============================================================================
API_PREFIX=/api

# ============================================================================
# CORS Settings (comma-separated origins)
# ============================================================================
CORS_ORIGINS=http://localhost:2000,http://127.0.0.1:2000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ============================================================================
# APPLICATION AUTH & SECURITY
# ============================================================================
SECRET_KEY=your-secret-key-here-change-in-production

# Default Admin Users (JSON format)
SEED_ADMINS=[{"username":"admin","password":"admin123","full_name":"Administrator"}]

# ============================================================================
# GOOGLE DRIVE CONFIGURATION
# ============================================================================
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id
GOOGLE_SERVICE_ACCOUNT_FILE=your-service-account-file.json


# ============================================================================
# MASTER PIPELINE CONFIGURATION
# ============================================================================

# Workspace Paths
PIPELINE_WORKSPACE=pipeline_workspace
DOWNLOADED_IMAGES_DIR=01_downloaded_from_drive
FINAL_OUTPUT_DIR=deliverable


# Deduplication Settings
DEDUP_THRESHOLD=0.85
USE_LLM_VALIDATION=false
MAX_LLM_VALIDATIONS=100

# Face Detection & Obfuscation
FACE_DETECTION_CONFIDENCE=0.5
FACE_VERIFICATION_THRESHOLD=0.4
OBFUSCATION_METHOD=egoblur
FILTER_ANIMAL_FACES=true
YOLO_MODEL=yolov8n.pt

# Pipeline Behavior
VERBOSE_LOGGING=true
NUM_WORKERS=4
PIPELINE_TIMEOUT=3600
CLEANUP_TEMP_FILES=true

# Output Format
OUTPUT_FORMAT=jpg
JPEG_QUALITY=95
PRESERVE_ORIGINAL_FORMAT=true

# Development/Debug
DRY_RUN=false
# LIMIT_IMAGES=10

# Default Pipeline Steps
RUN_DOWNLOAD_BY_DEFAULT=false
RUN_DEDUPLICATE_BY_DEFAULT=false
RUN_BIOMETRIC_BY_DEFAULT=false
RUN_ALL_BY_DEFAULT=true

# ============================================================================
# OPENAI API (Optional - for LLM validation in dedup)
# ============================================================================
# OPENAI_API_KEY=sk-your-openai-api-key

# ============================================================================
# TURING API / ARBITER CLASSIFIER CONFIGURATION
# ============================================================================
TURING_API_URL=https://kong.turing.com/api/v2/chat
TURING_API_KEY=your-turing-api-key
TURING_GW_KEY=your-turing-gw-key
TURING_AUTH=Basic your-auth-token

# Arbiter Models
GEMINI_MODEL=gemini-2.5-pro
GEMINI_PROVIDER=google
GEMINI_PROMPT_VERSION=1
OPENAI_MODEL=gpt-4o
OPENAI_PROVIDER=openai
OPENAI_PROMPT_VERSION=1
ARBITER_MODEL=o3
ARBITER_PROVIDER=openai
ARBITER_PROMPT_VERSION=1

# Arbiter Processing
ARBITER_BATCH_SIZE=50
ARBITER_MAX_RETRIES=2
ARBITER_TIMEOUT_SECONDS=120
ARBITER_PARALLEL_WORKERS=5
ARBITER_PIPELINE_VERSION=1

# ============================================================================
# BIOMETRIC COMPLIANCE PIPELINE SETTINGS
# ============================================================================
# Detection Thresholds
STANDARD_CONFIDENCE=0.6
ENHANCED_CONFIDENCE=0.4

# Person Validation (YOLO-based)
REQUIRE_PERSON_VALIDATION=true
PERSON_DETECTION_CONFIDENCE=0.3

# Quality Filtering
MIN_FACE_BRIGHTNESS=40
MIN_FACE_CONTRAST=30

# Animal Face Filtering
FILTER_ANIMAL_FACES=True
ANIMAL_IOU_THRESHOLD=0.3

# Enhanced Privacy Jurisdictions
ENHANCED_JURISDICTIONS=IL,CO,TX,WA,NY,MD,JP,CA,EU

# Anonymization Method (egoblur | gaussian | pixelate | solid)
ANONYMIZATION_METHOD=egoblur
EGOBLUR_INTENSITY=1.0
BLUR_KERNEL_SIZE=99
BLUR_SIGMA=30
PIXELATE_SIZE=12

# Face Region Parameters
FACE_PADDING_RATIO=0.3
VERIFICATION_THRESHOLD=0.3

# QA Sampling Rates
STANDARD_SAMPLING_RATE=0.10
ENHANCED_SAMPLING_RATE=1.0

# Model Configuration
FACE_DETECTOR_MODEL=buffalo_sc
DETECTION_SIZE=640
