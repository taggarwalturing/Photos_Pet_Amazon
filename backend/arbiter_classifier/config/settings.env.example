# ============================================================================
# ARBITER CLASSIFIER CONFIGURATION
# ============================================================================
# Strategy: Gemini + OpenAI classify with reasoning
#           On disagreement → Arbiter model decides
# Version: 1.0.0

# API Configuration
TURING_API_URL=https://kong.turing.com/api/v2/chat
TURING_API_KEY=YOUR_API_KEY
TURING_GW_KEY=YOUR_GW_KEY
TURING_AUTH=YOUR_AUTH

# Model 1: Gemini (with reasoning)
GEMINI_MODEL=gemini-2.5-pro
GEMINI_PROVIDER=google
GEMINI_PROMPT_VERSION=1

# Model 2: OpenAI (with reasoning)
OPENAI_MODEL=gpt-4o
OPENAI_PROVIDER=openai
OPENAI_PROMPT_VERSION=1

# Model 3: Arbiter (called only on disagreements)
ARBITER_MODEL=o3
ARBITER_PROVIDER=openai
ARBITER_PROMPT_VERSION=1

# Processing Configuration
BATCH_SIZE=50
MAX_RETRIES=2
TIMEOUT_SECONDS=120
TEMPERATURE=0

# Parallel Processing
PARALLEL_WORKERS=5

# Version Control
PIPELINE_VERSION=1

# Output Configuration
RESULTS_DIR=results
